# ---------------------------------------------------------------------------
# FlexIA Hub — ai-service. Copie para .env e ajuste.
# ---------------------------------------------------------------------------
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Banco do docker-compose (docker compose up -d db): usuário flexia, senha = POSTGRES_PASSWORD
# do .env da raiz, porta 5433. Com um PostgreSQL próprio, troque usuário, senha e porta.
DATABASE_URL="postgresql://flexia:CHANGE_ME@localhost:5433/flexia_hub"

# Segredo compartilhado com o backend (mesmo valor de AI_SERVICE_TOKEN em backend/.env).
# Com ele, só o backend consegue chamar /ask e /reindex. Obrigatório quando APP_ENV=production.
SERVICE_TOKEN=

# Este serviço é chamado só pelo backend (servidor para servidor): CORS fica fechado.
# Preencha apenas se precisar chamá-lo direto de um navegador (não recomendado).
CORS_ORIGINS=

# Chave da Anthropic (console.anthropic.com -> Settings -> API Keys)
# Sem ela, o serviço continua funcionando em modo "busca sem síntese por IA".
ANTHROPIC_API_KEY=

# Opcional: sobrescrever os modelos usados em cada etapa do grafo
AI_ROUTER_MODEL=claude-haiku-5-5
AI_SYNTHESIS_MODEL=claude-sonnet-5-5

# Opcional: fração do índice que pode mudar antes de o modelo de embeddings ser reajustado do zero
# RAG_REFIT_THRESHOLD=0.3
