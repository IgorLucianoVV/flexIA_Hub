# ---------------------------------------------------------------------------
# FlexIA Hub — backend. Copie para .env e ajuste.
# Tudo aqui é validado na subida (src/config.ts): se faltar algo obrigatório,
# o serviço não sobe e diz qual variável está errada.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Banco do docker-compose (docker compose up -d db): usuário flexia, senha = POSTGRES_PASSWORD
# do .env da raiz, porta 5433. Com um PostgreSQL próprio, troque usuário, senha e porta.
DATABASE_URL="postgresql://flexia:CHANGE_ME@localhost:5433/flexia_hub"

# OBRIGATÓRIO, sem valor padrão. Gere um de verdade: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-forte"
# Sessão: access token curto + refresh token rotativo (ver README, seção "Sessão e segurança")
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30

# Origens do frontend autorizadas, separadas por vírgula. Vazio = qualquer origem (só em dev).
# Ex.: CORS_ORIGINS=https://hub.flexia.com.br
CORS_ORIGINS=
# Atrás de proxy reverso/balanceador (nginx, docker-compose do projeto)? Use true.
TRUST_PROXY=false
# Limite de requisições por IP (login, cadastro, redefinição de senha e teto geral da API).
RATE_LIMIT_ENABLED=true
# Sem provedor de email, o token de redefinição de senha é devolvido na resposta da API.
# Padrão: true em desenvolvimento, false em produção. Não ligue em produção.
# EXPOSE_RESET_TOKEN=false

# Serviço de IA (LangGraph + RAG) — ver ai-service/.env para a chave da Anthropic
AI_SERVICE_URL="http://localhost:8000"
# Segredo compartilhado backend ↔ ai-service (mesmo valor de SERVICE_TOKEN no ai-service/.env).
# Vazio = sem autenticação entre os serviços (aceitável só em desenvolvimento local).
AI_SERVICE_TOKEN=

# Arquivos anexados ao Catálogo (PDF, imagens, exportações de bot…). Vazio = backend/data/uploads.
# No docker-compose fica num volume próprio (uploads_data).
UPLOADS_DIR=
MAX_UPLOAD_MB=25

# GitLab (preencher quando disponível)
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_GROUP=

# ClickUp (preencher com um Personal API Token gerado em ClickUp > Settings > Apps)
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=3034181
