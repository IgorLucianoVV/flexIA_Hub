# ---------------------------------------------------------------------------
# FlexIA Hub — variáveis do docker-compose. Copie para .env e preencha.
# (Para rodar sem Docker, cada serviço tem o seu próprio .env.example.)
# ---------------------------------------------------------------------------

# Senha do PostgreSQL (qualquer valor forte; fica só dentro da rede do compose)
POSTGRES_PASSWORD=

# Segredo que assina os tokens de login. Gere com: openssl rand -base64 48
JWT_SECRET=

# Segredo compartilhado entre a API e o serviço de IA. Gere com: openssl rand -hex 32
AI_SERVICE_TOKEN=

# Porta em que o Hub fica disponível no host
HUB_PORT=8080

# Chave da Anthropic (opcional). Sem ela o Assistente funciona em modo "busca sem síntese".
ANTHROPIC_API_KEY=

# Integrações (opcionais)
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_GROUP=
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=3034181
